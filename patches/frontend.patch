+  <v-dialog
+    :model-value="visible"
+    transition="dialog-bottom-transition"
+    width="920"
+    @update:model-value="onDialogToggle"
+  >
+    <v-card class="rounded-lg">
+      <v-card-title>
+        <v-row align="center">
+          <v-col>{{ $t('relay.users') }}<span
+            v-if="name"
+            class="text-medium-emphasis"
+          > · {{ name }}</span></v-col>
+          <v-spacer />
+          <v-col cols="auto">
+            <v-icon
+              icon="mdi-close-box"
+              @click="$emit('close')"
+            />
+          </v-col>
