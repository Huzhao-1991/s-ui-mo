+            :key="i"
+            :model-value="u"
+            readonly
+            density="compact"
+            hide-details
+            variant="outlined"
+            append-inner-icon="mdi-content-copy"
+            style="font-size: 0.74rem; margin-bottom: 6px;"
+            @click:append-inner="copy(u)"
+          />
+        </v-card>
+        <div style="text-align: end; margin-top: 10px;">
+          <span style="font-size: 0.8rem; opacity: 0.7; margin-inline-end: 10px;">
+            {{ $t('client.exportSummary', { u: groups.length, n: count }) }}
+          </span>
+          <v-btn
+            color="primary"
+            variant="tonal"
+            :disabled="!text"
+            @click="copy(text)"
+          >
+            {{ $t('client.copyAll') }}
+          </v-btn>
+        </div>
+      </v-card-text>
+      <v-card-actions>
+        <v-spacer />
+        <v-btn
+          color="primary"
+          variant="outlined"
+          @click="$emit('close')"
+        >
+          {{ $t('actions.close') }}
+        </v-btn>
+      </v-card-actions>
+    </v-card>
+  </v-dialog>
+</template>
