# 默认按文本处理，仓库内统一存 LF
* text=auto eol=lf

# 这些是给 Linux 跑的，必须是 LF
*.sh   text eol=lf
*.service text eol=lf
Dockerfile text eol=lf
*.go   text eol=lf
*.ts   text eol=lf
*.vue  text eol=lf
*.json text eol=lf
*.yml  text eol=lf

# Windows 批处理要 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制，别动
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.exe  binary
*.gz   binary
